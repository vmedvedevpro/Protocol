{
  "app": {
    "windows": [
      {
        "title": "Protocol",
        "url": "/",
        "width": 460,
        "height": 700,
        "minWidth": 360,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": {
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost http://127.0.0.1:* blob:"
      }
    }
  },
  "bundle": {
    "targets": [
      "appimage",
      "deb"
    ],
    "resources": [
      "templates/*.json",
      "resources/diarization/*",
      "resources/speech-check/*",
      "binaries/onnxruntime/*"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "desktopTemplate": "linux/main.desktop"
      }
    }
  }
}
