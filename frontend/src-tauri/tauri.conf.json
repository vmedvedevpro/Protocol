{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Protocol",
    "version": "0.2.22",
    "identifier": "io.github.vmedvedevpro.protocol",
    "build": {
        "frontendDist": "../out",
        "devUrl": "http://localhost:3118",
        "beforeDevCommand": "node scripts/dev-runner.js",
        "beforeBuildCommand": "node node_modules/next/dist/bin/next build"
    },
    "app": {
        "windows": [
            {
                "title": "Protocol",
                "url": "/",
                "width": 1280,
                "height": 760,
                "minWidth": 700,
                "center": true,
                "resizable": true,
                "fullscreen": false,
                "theme": "Dark",
                "decorations": true
            }
        ],
        "macOSPrivateApi": true,
        "security": {
            "csp": {
                "default-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' asset: https://asset.localhost data:",
                "media-src": "'self' asset: http://asset.localhost https://asset.localhost blob:",
                "connect-src": "'self' http://localhost:11434 http://localhost:5167 http://localhost:8178 https://api.ollama.ai"
            },
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$APPDATA/**"
                ]
            },
            "capabilities": [
                {
                    "identifier": "main",
                    "description": "Main window capability with file system and media access",
                    "windows": [
                        "main",
                        "minibar"
                    ],
                    "permissions": [
                        "fs:default",
                        "fs:allow-read-file",
                        "fs:read-all",
                        "fs:write-all",
                        "fs:allow-app-read",
                        "fs:allow-app-write",
                        "fs:allow-download-write",
                        "fs:allow-download-read",
                        "fs:scope-download",
                        "core:path:default",
                        "core:event:default",
                        "core:window:default",
                        "core:window:allow-set-theme",
                        "core:app:default",
                        "core:resources:default",
                        "core:menu:default",
                        "core:tray:default",
                        "core:window:allow-set-title",
                        "core:window:allow-minimize",
                        "core:window:allow-toggle-maximize",
                        "core:window:allow-close",
                        "core:window:allow-start-dragging",
                        "core:window:allow-internal-toggle-maximize",
                        "store:default",
                        "dialog:allow-save",
                        "notification:default",
                        "notification:allow-is-permission-granted",
                        {
                            "identifier": "fs:scope",
                            "allow": [
                                {
                                    "path": "$APPDATA/*"
                                }
                            ]
                        }
                    ]
                },
                {
                    "identifier": "minibar-drag",
                    "windows": ["minibar"],
                    "permissions": ["core:window:allow-start-dragging"]
                }
            ]
        }
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": true,
        "publisher": "vmedvedevpro",
        "targets": [
            "nsis"
        ],
        "icon": [
            "icons/icon.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": [
            "templates/*.json",
            "resources/diarization/*",
            "runtime-deps/*",
            "installer-variants/*"
        ],
        "externalBin": [
            "binaries/llama-helper",
            "binaries/ffmpeg"
        ],
        "macOS": {
            "entitlements": "entitlements.plist",
            "signingIdentity": "-",
            "hardenedRuntime": true
        },
        "windows": {
            "signCommand": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -FilePath %1",
            "webviewInstallMode": {
                "type": "embedBootstrapper",
                "silent": true
            },
            "nsis": {
                "installMode": "currentUser",
                "displayLanguageSelector": false,
                "template": "./windows/installer.nsi",
                "installerHooks": "./windows/installer-hooks.nsh",
                "installerIcon": "./icons/icon.ico",
                "languages": ["English"],
                "customLanguageFiles": {
                    "English": "./windows/English.nsh"
                }
            }
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBMjIyM0YyMUE3OEEzOEEKUldTS28zZ2E4aU1paWxodjB3RHFBcW1acHRvMVlVRndwZjYvM0RCcE5wcElqSXZMVVQzUkswbWYK",
            "endpoints": [
                "https://github.com/vmedvedevpro/Protocol/releases/latest/download/latest.json"
            ],
            "requireSignedVersion": true,
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
