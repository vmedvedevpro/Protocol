      "files": [
        { "name": "encoder-model.int8.onnx", "path": "encoder-model.int8.onnx" },
        { "name": "decoder_joint-model.int8.onnx", "path": "decoder_joint-model.int8.onnx" },
        { "name": "nemo128.onnx", "path": "nemo128.onnx" },
        { "name": "vocab.txt", "path": "vocab.txt" }
      ]
    },
    "llama": {
      "id": "gemma3:1b",
      "engine": "llama",
      "format": "gguf",
      "name": "Gemma 3 1B (Fast)",
