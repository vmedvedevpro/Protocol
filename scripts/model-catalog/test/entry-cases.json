{
  "_comment": "Shared by scripts/model-catalog/test/check-catalog.test.mjs and model_catalog::schema tests in Rust. Each case starts from a base entry, sets the dotted paths in `set` and deletes those in `remove`.",
  "bases": {
    "whisper": {
      "id": "tiny",
      "engine": "whisper",
      "format": "ggml",
      "name": "Whisper tiny",
      "description": "Fastest processing",
      "languages": ["*"],
      "accuracy": "Decent",
      "speed": "Very Fast",
      "license": { "name": "MIT", "url": "https://github.com/openai/whisper/blob/main/LICENSE" },
      "repo": "ggerganov/whisper.cpp",
      "files": [{ "name": "ggml-tiny.bin", "path": "ggml-tiny.bin" }]
    },
    "parakeet": {
      "id": "parakeet-tdt-0.6b-v3-int8",
      "engine": "parakeet",
      "format": "onnx-tdt-int8",
      "name": "Lightning",
