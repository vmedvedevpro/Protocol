      "rank": 1,
      "license": { "name": "Gemma Terms of Use", "url": "https://ai.google.dev/gemma/terms" },
      "repo": "bartowski/google_gemma-3-1b-it-GGUF",
      "files": [{ "name": "gemma-3-1b-it-Q8_0.gguf", "path": "google_gemma-3-1b-it-Q8_0.gguf" }],
      "params": {
        "chat_format": "gemma3",
        "context_size": 32768,
        "sampling": { "temperature": 1.0, "top_k": 64, "top_p": 0.95, "presence_penalty": 0.0, "frequency_penalty": 0.0, "repeat_penalty": 1.0, "penalty_last_n": 0 },
        "stop_tokens": ["<end_of_turn>"]
      }
    }
  },
  "cases": [
    { "name": "whisper base entry", "base": "whisper", "valid": true },
    { "name": "parakeet base entry", "base": "parakeet", "valid": true },
    { "name": "llama base entry", "base": "llama", "valid": true },
    { "name": "pinned commit", "base": "whisper", "set": { "revision": "5359861c739e955e79d9a303bcbc70fb988958b1" }, "valid": true },
    { "name": "minimum app version", "base": "llama", "set": { "min_app_version": "0.4.0" }, "valid": true },
    { "name": "file in a folder of the repository", "base": "llama", "set": { "files": [{ "name": "model.gguf", "path": "Q4/model.gguf" }] }, "valid": true },
    { "name": "unknown fields are ignored", "base": "whisper", "set": { "future_field": { "anything": 1 } }, "valid": true },
    { "name": "uppercase id", "base": "whisper", "set": { "id": "Tiny" }, "valid": false },
    { "name": "id with a slash", "base": "whisper", "set": { "id": "a/b" }, "valid": false },
    { "name": "unknown engine", "base": "whisper", "set": { "engine": "gigaam" }, "valid": false },
    { "name": "unknown format", "base": "whisper", "set": { "format": "gguf" }, "valid": false },
    { "name": "missing name", "base": "whisper", "remove": ["name"], "valid": false },
    { "name": "no languages", "base": "whisper", "set": { "languages": [] }, "valid": false },
    { "name": "bad language code", "base": "whisper", "set": { "languages": ["English"] }, "valid": false },
    { "name": "unknown tier", "base": "whisper", "set": { "tier": "pro" }, "valid": false },
    { "name": "listed is not a boolean", "base": "whisper", "set": { "listed": "no" }, "valid": false },
    { "name": "negative rank", "base": "llama", "set": { "rank": -1 }, "valid": false },
    { "name": "license over http", "base": "whisper", "set": { "license.url": "http://example.com" }, "valid": false },
    { "name": "repository without owner", "base": "whisper", "set": { "repo": "whisper.cpp" }, "valid": false },
    { "name": "repository url instead of a name", "base": "whisper", "set": { "repo": "https://huggingface.co/ggerganov/whisper.cpp" }, "valid": false },
    { "name": "branch name as revision", "base": "whisper", "set": { "revision": "main" }, "valid": false },
    { "name": "short commit as revision", "base": "whisper", "set": { "revision": "5359861" }, "valid": false },
    { "name": "app version with a prefix", "base": "whisper", "set": { "min_app_version": "v0.4.0" }, "valid": false },
    { "name": "no files", "base": "whisper", "set": { "files": [] }, "valid": false },
    { "name": "path leaving the repository", "base": "whisper", "set": { "files": [{ "name": "ggml-tiny.bin", "path": "../ggml-tiny.bin" }] }, "valid": false },
    { "name": "absolute path", "base": "whisper", "set": { "files": [{ "name": "ggml-tiny.bin", "path": "/ggml-tiny.bin" }] }, "valid": false },
    { "name": "file name with a folder", "base": "llama", "set": { "files": [{ "name": "a/model.gguf", "path": "model.gguf" }] }, "valid": false },
    { "name": "hidden file name", "base": "llama", "set": { "files": [{ "name": ".model.gguf", "path": "model.gguf" }] }, "valid": false },
    { "name": "whisper file not named after the id", "base": "whisper", "set": { "files": [{ "name": "ggml-base.bin", "path": "ggml-base.bin" }] }, "valid": false },
    { "name": "whisper with two files", "base": "whisper", "set": { "files": [{ "name": "ggml-tiny.bin", "path": "ggml-tiny.bin" }, { "name": "extra.bin", "path": "extra.bin" }] }, "valid": false },
    { "name": "parakeet missing its vocabulary", "base": "parakeet", "set": { "files": [{ "name": "encoder-model.int8.onnx", "path": "encoder-model.int8.onnx" }, { "name": "decoder_joint-model.int8.onnx", "path": "decoder_joint-model.int8.onnx" }, { "name": "nemo128.onnx", "path": "nemo128.onnx" }] }, "valid": false },
    { "name": "parakeet file listed twice", "base": "parakeet", "set": { "files": [{ "name": "encoder-model.int8.onnx", "path": "encoder-model.int8.onnx" }, { "name": "encoder-model.int8.onnx", "path": "decoder_joint-model.int8.onnx" }, { "name": "nemo128.onnx", "path": "nemo128.onnx" }, { "name": "vocab.txt", "path": "vocab.txt" }] }, "valid": false },
    { "name": "llama file that is not gguf", "base": "llama", "set": { "files": [{ "name": "model.bin", "path": "model.bin" }] }, "valid": false },
    { "name": "llama without params", "base": "llama", "remove": ["params"], "valid": false },
    { "name": "unknown chat format", "base": "llama", "set": { "params.chat_format": "llama3" }, "valid": false },
    { "name": "tiny context", "base": "llama", "set": { "params.context_size": 128 }, "valid": false },
    { "name": "sampling field missing", "base": "llama", "remove": ["params.sampling.top_p"], "valid": false },
    { "name": "fractional top_k", "base": "llama", "set": { "params.sampling.top_k": 20.5 }, "valid": false },
    { "name": "sampling field as text", "base": "llama", "set": { "params.sampling.temperature": "0.5" }, "valid": false },
    { "name": "no stop tokens", "base": "llama", "set": { "params.stop_tokens": [] }, "valid": false },
    { "name": "params on whisper", "base": "whisper", "set": { "params": { "context_size": 4096 } }, "valid": false }
  ]
}
